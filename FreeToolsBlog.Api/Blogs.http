@baseUrl = http://localhost:5175
@adminEmail = admin@freetoolsblog.local
@adminPassword = Ahihi213@

### Public: list posts
GET {{baseUrl}}/posts?pageNumber=1&pageSize=5

### Public: get post by slug
GET {{baseUrl}}/posts/5-cong-cu-truc-tuyen-mien-phi

### Public: list comments for post 1
GET {{baseUrl}}/posts/1/comments?pageNumber=1&pageSize=3

### Public: add a comment to post 1
POST {{baseUrl}}/posts/1/comments
Content-Type: application/json

{
  "name": "John",
  "content": "Bài viết rất hữu ích!"
}

### Admin: login (run this first; following requests use its accessToken)
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Admin: verify requests without a token are rejected (expect 401)
POST {{baseUrl}}/admin/posts/
Content-Type: application/json

{
  "title": "Unauthorized test",
  "slug": "unauthorized-test",
  "summary": "Should not be created",
  "content": "This request should return 401.",
  "coverImageUrl": null,
  "userId": 1
}

### Admin: create post (run login first)
# @name createPost
POST {{baseUrl}}/admin/posts/
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Bài viết thử nghiệm",
  "slug": "bai-viet-thu-nghiem",
  "summary": "Bài viết tạo từ Blogs.http.",
  "content": "Nội dung thử nghiệm.",
  "coverImageUrl": null,
  "userId": 1
}

### Admin: update the post created above
PUT {{baseUrl}}/admin/posts/{{createPost.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Bài viết thử nghiệm (đã sửa)",
  "slug": "bai-viet-thu-nghiem",
  "summary": "Đã cập nhật từ Blogs.http.",
  "content": "Nội dung đã chỉnh sửa.",
  "isPublished": false,
  "coverImageUrl": null
}

### Admin: delete the post created above
DELETE {{baseUrl}}/admin/posts/{{createPost.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
